{
  // markdownlint-cli2 配置. 用法:
  //
  //     markdownlint-cli2            # 按下面的 globs 检查全仓库
  //     markdownlint-cli2 --fix      # 自动修可修的项 (空行 / 列表符号等)
  //
  // 需要 npx / 全局安装 markdownlint-cli2, 本仓库不把它放进 Python 依赖.
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",

  // 全仓库的 Markdown; .venv / .tox / dist 等在 .gitignore 里, 由 gitignore 兜底.
  "globs": ["**/*.md"],
  "gitignore": true,

  "config": {
    // 行长度: 只约束正文段落. 表格与代码块本来就不该折行, 标题也没法折;
    // 这三类放开后, 剩下的才是真正该收的正文行.
    "MD013": {
      "line_length": 80,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },

    // Keep a Changelog 在每个版本小节下都会重复 Added / Fixed / Changed 等标题,
    // 它们不是同级标题, 因此只对同级重名报错.
    "MD024": { "siblings_only": true }
  }
}
